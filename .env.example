# LLM 백엔드: mock | ollama | vllm
FDM_BACKEND=ollama

# 로컬(Ollama) 기본값
FDM_OLLAMA_BASE_URL=http://localhost:11434/v1
# 비대칭 배치: 옹호자/회의론자/페르소나는 작은 모델, 심판은 큰 모델
# FDM_MODEL_SMALL=Qwen/Qwen3-14B
# FDM_MODEL_JUDGE=LGAI-EXAONE/EXAONE-4.0-32B

# Colab/vLLM 사용 시 (예: EXAONE 4.0 32B 4bit를 심판으로)
# FDM_BACKEND=vllm
# FDM_VLLM_BASE_URL=http://localhost:8000/v1
# 사설/상용 OpenAI-compatible 서버를 배포 앱에서 호출할 때
# FDM_LLM_BASE_URL=https://your-llm-server.example.com/v1
# FDM_LLM_API_KEY=...
# FDM_MODEL_SMALL=Qwen/Qwen3-14B
# FDM_MODEL_JUDGE=LGAI-EXAONE/EXAONE-4.0-32B

# OpenAI API를 직접 사용할 때
# FDM_BACKEND=openai
# FDM_OPENAI_BASE_URL=https://api.openai.com/v1
# FDM_OPENAI_API_KEY=...
# FDM_MODEL_SMALL=gpt-4.1-mini
# FDM_MODEL_JUDGE=gpt-4.1

# Gemini API를 사용할 때 (OpenAI-compatible endpoint)
# FDM_BACKEND=gemini
# FDM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# FDM_GEMINI_API_KEY=...
# FDM_MODEL_SMALL=gemini-3.6-flash
# FDM_MODEL_JUDGE=gemini-3.6-flash
# Gemini 사고 강도: low 권장. 2.5 계열에서 더 빠르게 하려면 none도 가능.
FDM_GEMINI_REASONING_EFFORT=low

FDM_TIMEOUT=180
FDM_MAX_TOKENS=1200
FDM_NUM_CTX=6144
FDM_TEMP_DEBATER=0.5
FDM_TEMP_JUDGE=0.2

# 하이브리드 추론 모델(Qwen3·EXAONE)의 사고 모드.
# 1로 켜면 2~3배 느려지고, 토큰 예산을 <think>가 다 써서 본문이 빈 응답으로
# 잘리는 일이 생긴다(측정: 1200토큰 전부 사고에 소진, 본문 0자). 기본 0 권장.
FDM_THINK=0
# 모델을 VRAM에 유지하는 시간 (매 호출마다 재적재하지 않도록)
FDM_KEEP_ALIVE=30m

# 공개 API 키 (선택)
# 금융상품 한눈에 (finlife.fss.or.kr) 인증키
FINLIFE_API_KEY=
# KOSIS 오픈API 인증키
KOSIS_API_KEY=
